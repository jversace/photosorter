# Copiez ce fichier en keystore.properties à la racine du projet (non versionné).
# Renseignez vos valeurs réelles. NE COMMITEZ JAMAIS keystore.properties.

# Chemin vers votre fichier keystore (relatif à la racine du projet)
storeFile=release.keystore

# Mot de passe du keystore
storePassword=VOTRE_MOT_DE_PASSE_KEYSTORE

# Alias de la clé dans le keystore
keyAlias=photosorter

# Mot de passe de la clé
keyPassword=VOTRE_MOT_DE_PASSE_CLE
